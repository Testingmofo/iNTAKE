{
  "manifest_version": 3,
  "name": "iNTAKE // Media NetCrawler",
  "version": "1.3.2",
  "description": "Queues media from supported browser pages into the local iNTAKE application.",
  "permissions": ["nativeMessaging"],
  "key": "",
  "host_permissions": [
    "http://127.0.0.1:17845/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": ["notifications.js", "youtube.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://rule34.xxx/*",
        "https://*.rule34.xxx/*"
      ],
      "js": ["notifications.js", "rule34.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://rule34.xxx/*",
        "https://*.rule34.xxx/*"
      ],
      "js": ["notifications.js", "generic.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
